{
  "name": "research-dispatch",
  "version": "1.0.4",
  "description": "Multi-model review dispatch for DeepSeek Harness: seats decide who reviews, votes decide how many seats run, every round lands on disk as cards.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./run": "./lib/run.mjs",
    "./models": "./lib/models.mjs",
    "./bin": "./bin/dispatch.mjs",
    "./client": "./lib/client.js"
  },
  "bin": {
    "research-dispatch": "./bin/dispatch.mjs"
  },
  "files": [
    "lib/",
    "bin/",
    "skills/",
    "examples/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "test/*.selftest.mjs"
  ],
  "scripts": {
    "test": "node test/flow.selftest.mjs && node test/client.selftest.mjs && node test/run.selftest.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "multi-model",
    "review",
    "llm",
    "codex",
    "claude",
    "qoder"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "author": "asdasd-maker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asdasd-maker/research-dispatch.git"
  },
  "homepage": "https://github.com/asdasd-maker/research-dispatch#readme",
  "bugs": {
    "url": "https://github.com/asdasd-maker/research-dispatch/issues"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
