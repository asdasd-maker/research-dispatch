{
  "name": "research-dispatch",
  "version": "2.0.0",
  "description": "Universal pure-Node AI research workflow engine: literature pool, baseline repro, dead-end-aware divergence, out-of-repo isolated multi-agent review, paired pilot statistics, and frozen experiment contracts across Antigravity, Claude Code, Codex, Cursor, and DeepSeek Harness.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./run": "./lib/run.mjs",
    "./models": "./lib/models.mjs",
    "./validators": "./lib/validators.mjs",
    "./workflow": "./lib/workflow.mjs",
    "./pilot-stats": "./lib/pilot-stats.mjs",
    "./bin": "./bin/dispatch.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "research-dispatch": "./bin/dispatch.mjs"
  },
  "files": [
    "lib/",
    "bin/",
    "skills/",
    "examples/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/flow.selftest.mjs && node test/client.selftest.mjs && node test/run.selftest.mjs && node test/standalone.selftest.mjs && node test/workflow.selftest.mjs"
  },
  "keywords": [
    "research-workflow",
    "ai-research",
    "multi-agent",
    "antigravity",
    "claude-code",
    "codex",
    "cursor",
    "gemini-cli",
    "deepseek-harness",
    "dsh-plugin",
    "ablation-contract",
    "paired-bootstrap"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "author": "asdasd-maker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asdasd-maker/research-dispatch.git"
  },
  "homepage": "https://github.com/asdasd-maker/research-dispatch#readme",
  "bugs": {
    "url": "https://github.com/asdasd-maker/research-dispatch/issues"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
