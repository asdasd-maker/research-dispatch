{
  "version": 2,
  "policy": {
    "require_unique_models": false
  },
  "lineup": {
    "scout": {
      "seat": "codex",
      "model": ""
    },
    "diverge": {
      "seat": "codex",
      "model": "",
      "count": 10,
      "use_dead_ends": true
    },
    "review": [
      {
        "seat": "codex",
        "model": ""
      },
      {
        "seat": "claude",
        "model": ""
      }
    ],
    "novelty": {
      "seat": "claude",
      "model": ""
    }
  },
  "paths": {
    "cards_dir": "ideas/cards",
    "workers_dir": "workers",
    "role_file": "roles/reviewer.md",
    "require_anchor": false
  },
  "default_backends": [
    "codex",
    "claude"
  ],
  "seats": [
    {
      "id": "codex",
      "kind": "cli",
      "enabled": true,
      "command": "codex",
      "argv": [
        "exec",
        "--sandbox",
        "read-only",
        "--skip-git-repo-check",
        "-C",
        "{workers_dir}",
        "{optional_args}",
        "-o",
        "{tmp}",
        "-"
      ],
      "payload_position": "stdin",
      "output": "file",
      "optional_args": [
        {
          "env": "CODEX_MODEL",
          "argv": [
            "-m",
            "{env}"
          ]
        }
      ],
      "identity": {
        "kind": "config",
        "explicit_env": "CODEX_MODEL",
        "file_env": "CODEX_CFG",
        "default_file": "~/.codex/config.toml",
        "pattern": "^model = \"[^\"]*\"",
        "cut_field": 2
      }
    },
    {
      "id": "claude",
      "kind": "cli",
      "enabled": true,
      "command": "claude",
      "argv": [
        "-p",
        "{payload}",
        "--output-format",
        "text",
        "--no-session-persistence",
        "{optional_args}"
      ],
      "payload_position": "argv",
      "output": "stdout",
      "optional_args": [
        {
          "env": "CLAUDE_MODEL",
          "argv": [
            "--model",
            "{env}"
          ]
        }
      ],
      "identity": {
        "kind": "config",
        "explicit_env": "CLAUDE_MODEL",
        "file_env": "CLAUDE_CFG",
        "default_file": "~/.claude/settings.json",
        "pattern": "\"(ANTHROPIC_MODEL|model)\"\\s*:\\s*\"[^\"]*\"",
        "cut_field": 4
      }
    },
    {
      "id": "dsh",
      "kind": "cli",
      "enabled": true,
      "command": "dsh",
      "argv": [
        "--profile",
        "headless",
        "{optional_args}",
        "{payload}"
      ],
      "payload_position": "argv",
      "output": "stdout",
      "patch_env": "DSH_PATCH",
      "optional_args": [
        {
          "env": "DSH_PATCH",
          "argv": [
            "--patch",
            "{env}"
          ]
        }
      ],
      "identity": {
        "kind": "settings",
        "explicit_env": "DSH_MODEL"
      }
    },
    {
      "id": "agy",
      "kind": "cli",
      "enabled": true,
      "command": "agy",
      "argv": [
        "-p",
        "{payload}",
        "--output-format",
        "text",
        "--disable-slash-commands",
        "{optional_args}"
      ],
      "payload_position": "argv",
      "output": "stdout",
      "optional_args": [
        {
          "env": "AGY_MODEL",
          "argv": [
            "--model",
            "{env}"
          ]
        }
      ],
      "identity": {
        "kind": "agy",
        "explicit_env": "AGY_MODEL",
        "file_env": "AGY_CFG",
        "default_file": "~/.gemini/antigravity-cli/settings.json",
        "pattern": "\"model\"\\s*:\\s*\"[^\"]*\"",
        "cut_field": 4
      }
    },
    {
      "id": "kimi",
      "kind": "cli",
      "enabled": true,
      "command": "kimi",
      "argv": [
        "-p",
        "{payload}",
        "--output-format",
        "text",
        "{optional_args}"
      ],
      "payload_position": "argv",
      "output": "stdout",
      "optional_args": [
        {
          "env": "KIMI_MODEL",
          "argv": [
            "-m",
            "{env}"
          ]
        }
      ],
      "identity": {
        "kind": "config",
        "explicit_env": "KIMI_MODEL",
        "file_env": "KIMI_CFG",
        "default_file": "~/.kimi/config.toml",
        "pattern": "^(?:default_model|model)\\s*=\\s*\"[^\"]*\"",
        "cut_field": 2
      }
    },
    {
      "id": "api",
      "kind": "api",
      "enabled": false,
      "base_env_var": "API_BASE_ENV",
      "base_env_default": "OPENAI_BASE_URL",
      "key_env_var": "API_KEY_ENV",
      "key_env_default": "OPENAI_API_KEY",
      "model": {
        "env": "API_MODEL",
        "default": "deepseek-chat"
      },
      "votes": {
        "env": "API_VOTES",
        "default": 1
      },
      "temperature": {
        "env": "API_TEMPERATURE",
        "default": "0.7"
      },
      "max_tokens": {
        "env": "API_MAX_TOKENS",
        "default": "4096"
      },
      "identity": {
        "kind": "api",
        "explicit_env": "API_MODEL"
      }
    },
    {
      "id": "manual1",
      "kind": "delivery",
      "enabled": false,
      "seat_pattern": "manual[0-9]+",
      "body_env": "{SEAT_UPPER}_BODY",
      "model_env": "{SEAT_UPPER}_MODEL",
      "attest_sha_env": "{SEAT_UPPER}_SHA",
      "identity": {
        "kind": "manual"
      }
    }
  ]
}
